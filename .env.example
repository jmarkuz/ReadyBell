# Copy to .env and fill in. Never commit .env.

DB_PASSWORD=change-me

# HS256 signing key, at least 32 characters:  openssl rand -base64 48
JWT_SECRET=

# Web Push keys:  python3 scripts/generate-vapid-keys.py
# Keep the same pair across deploys, changing it invalidates every browser subscription.
# Without real VAPID keys the app refuses to start; VAPID_ENABLED=false runs it without Web Push
# VAPID_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Platform operator who onboards restaurants. The password must be a bcrypt hash with the
# {bcrypt} prefix. Every "$" in the hash must be doubled ("$$"), otherwise Docker Compose mangles it:
#   echo "{bcrypt}$(htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n' | sed 's/$2y/$2a/; s/\$/$$/g')"
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD_HASH={bcrypt}

# Optional backup service (docker compose --profile backup up -d backup), see docs/DEPLOYMENT.md
# RETENTION_DAYS=14
# BACKUP_INTERVAL_HOURS=24

# Platform operator may sign in only from these networks (IPs or CIDRs, comma separated); empty = anywhere
# READYBELL_SECURITY_PLATFORM_ADMIN_ALLOWED_NETWORKS=
# Push services allowed besides FCM, Mozilla, Apple and Windows (comma separated, *. for subdomains); rarely needed
# READYBELL_PUSH_EXTRA_ALLOWED_HOSTS=
# Reverse proxy or tunnel in front of the app (IP or CIDR, comma separated), e.g. 172.16.0.0/12 for the Docker bridge
# Without it every visitor shares the proxy's address: one client can exhaust everyone's rate limits and lock everyone out of login
# RATE_LIMIT_TRUSTED_PROXIES=
