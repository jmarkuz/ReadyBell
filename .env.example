# Copy to .env and fill in. Never commit .env.

DB_PASSWORD=change-me

# HS256 signing key, at least 32 characters:  openssl rand -base64 48
JWT_SECRET=

# Web Push keys:  python3 scripts/generate-vapid-keys.py
# Keep the same pair across deploys, changing it invalidates every browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Platform operator who onboards restaurants. The password must be a bcrypt hash with the
# {bcrypt} prefix. Every "$" in the hash must be doubled ("$$"), otherwise Docker Compose mangles it:
#   echo "{bcrypt}$(htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n' | sed 's/$2y/$2a/; s/\$/$$/g')"
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD_HASH={bcrypt}

# Optional backup service (docker compose --profile backup up -d backup), see docs/DEPLOYMENT.md
# RETENTION_DAYS=14
# BACKUP_INTERVAL_HOURS=24

# Counter QR: how long after creation an order can still be claimed by its receipt number (default 4h)
# CLAIM_MAX_AGE=4h
